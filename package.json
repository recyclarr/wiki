{
  "name": "recyclarr-wiki",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "yarn gen-api-docs && cross-env DOCUSAURUS_GENERATED_FILES_DIR_NAME=.docusaurus-current GITHUB_REF=refs/heads/master CURRENT_URL=http://localhost:3000 OTHER_URL=http://localhost:3001 docusaurus start --no-open",
    "start:next": "yarn gen-api-docs && cross-env DOCUSAURUS_GENERATED_FILES_DIR_NAME=.docusaurus-next GITHUB_REF=refs/heads/next CURRENT_URL=http://localhost:3001 OTHER_URL=http://localhost:3000 docusaurus start --no-open --port 3001",
    "start:both": "concurrently -n current,next -c blue,magenta \"yarn start\" \"yarn start:next\"",
    "launch": "docusaurus start",
    "build": "yarn gen-api-docs && docusaurus build",
    "gen-api-docs": "docusaurus gen-api-docs all",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.0",
    "@docusaurus/faster": "^3.10.0",
    "@docusaurus/plugin-content-docs": "^3.10.0",
    "@docusaurus/preset-classic": "^3.10.0",
    "@docusaurus/theme-common": "^3.10.0",
    "@docusaurus/utils": "^3.10.0",
    "@docusaurus/utils-validation": "^3.10.0",
    "@iconify/react": "^6.0.2",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "docusaurus-plugin-openapi-docs": "^5.2.0",
    "docusaurus-plugin-sass": "^0.2.6",
    "docusaurus-theme-github-codeblock": "^2.0.2",
    "docusaurus-theme-openapi-docs": "^5.2.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sass": "^1.97.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.0",
    "cross-env": "^10.1.0",
    "prettier": "^3.8.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "yarn@4.18.1"
}
