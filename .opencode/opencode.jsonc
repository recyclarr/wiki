{
  "$schema": "https://opencode.ai/config.json",
  "formatter": {
    "prettier": {
      "command": ["npx", "prettier", "--write", "$FILE"],
      "extensions": [".js", ".jsx", ".ts", ".tsx", ".css", ".scss", ".json", ".yaml", ".yml"],
    },
  },
  "permissions": [
    // Sessions located here edit the wiki directly; the wiki subagent serves other directories
    { "action": "subagent", "resource": "wiki", "effect": "deny" },

    // Fine tune linear tools in context
    { "action": "linear_*", "resource": "*", "effect": "deny" },
    { "action": "linear_*_comment*", "resource": "*", "effect": "allow" },
    { "action": "linear_*_issue*", "resource": "*", "effect": "allow" },
    { "action": "linear_*_project*", "resource": "*", "effect": "allow" },
  ],
}
